<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="MyDesktopApp.MainWindow"
  Title="科学计算器"
  Width="320"
  Height="450"
>
  <Grid RowDefinitions="100, *" Margin="10">
    <!-- 顶部屏幕（字号稍微改小一点点，防止算式太长超出屏幕） -->
    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="5" Margin="5">
      <TextBlock
        x:Name="DisplayText"
        Text="0"
        FontSize="32"
        Foreground="White"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="10"
        TextWrapping="Wrap"
      />
    </Border>

    <!-- 底部按键区 -->
    <Grid Grid.Row="1" RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*" Margin="5">
      <Button
        Grid.Row="0"
        Grid.Column="0"
        Content="C"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="0"
        Grid.Column="1"
        Content="("
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="0"
        Grid.Column="2"
        Content=")"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="0"
        Grid.Column="3"
        Content="/"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />

      <Button
        Grid.Row="1"
        Grid.Column="0"
        Content="7"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="1"
        Grid.Column="1"
        Content="8"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="1"
        Grid.Column="2"
        Content="9"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="1"
        Grid.Column="3"
        Content="*"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />

      <Button
        Grid.Row="2"
        Grid.Column="0"
        Content="4"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="2"
        Grid.Column="1"
        Content="5"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="2"
        Grid.Column="2"
        Content="6"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="2"
        Grid.Column="3"
        Content="-"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />

      <Button
        Grid.Row="3"
        Grid.Column="0"
        Content="1"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="3"
        Grid.Column="1"
        Content="2"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="3"
        Grid.Column="2"
        Content="3"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="3"
        Grid.Column="3"
        Content="+"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />

      <Button
        Grid.Row="4"
        Grid.Column="0"
        Content="0"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="4"
        Grid.Column="1"
        Content="."
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <!-- 注意这里，我把箭头改成了 DEL -->
      <Button
        Grid.Row="4"
        Grid.Column="2"
        Content="DEL"
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
      <Button
        Grid.Row="4"
        Grid.Column="3"
        Content="="
        Click="OnButtonClick"
        Margin="3"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
      />
    </Grid>
  </Grid>
</Window>
